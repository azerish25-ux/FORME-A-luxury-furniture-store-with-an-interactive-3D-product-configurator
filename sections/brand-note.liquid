<section class="brand-note wrap"><p class="eyebrow">{{ section.settings.eyebrow }}</p><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.body }}</p><a href="{{ section.settings.link | default: '/pages/about' }}" class="underlined-link">Our point of view {% render 'icon', name: 'diagonal' %}</a></div><span class="brand-note__mark" aria-hidden="true">f.</span></section>
{% schema %}
{
  "name": "Brand note",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FORME PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less, but more considered."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We believe the pieces you live with should give more than they take. A little warmth. A moment of ease. A feeling of belonging. Nothing unnecessary. Everything considered."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Story link"
    }
  ],
  "presets": [
    {
      "name": "Brand note"
    }
  ]
}
{% endschema %}
