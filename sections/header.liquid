<div class="announcement"><p>{{ section.settings.announcement }}</p><a href="{{ section.settings.announcement_link | default: '/pages/delivery' }}">The considered delivery {% render 'icon', name: 'arrow' %}</a></div>
<header class="site-header">
  <button type="button" class="icon-button mobile-menu-trigger" aria-label="Open navigation" aria-controls="MobileNavigation" aria-expanded="false" data-menu-toggle>{% render 'icon', name: 'menu' %}</button>
  <a href="{{ routes.root_url }}" class="wordmark" aria-label="FORME home">FORME<span class="wordmark-dot">.</span></a>
  <nav class="desktop-navigation" aria-label="Main navigation">
    {% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}{% else %}
      <a href="{{ routes.all_products_collection_url }}">The collection</a><a href="/pages/materials">Our materials</a><a href="/pages/journal">The journal</a>
    {% endif %}
  </nav>
  <div class="header-actions"><a class="studio-link" href="/products/arc-modular-sofa">Design your sofa {% render 'icon', name: 'diagonal' %}</a><a href="{{ routes.search_url }}" class="icon-button" aria-label="Search the collection">{% render 'icon', name: 'search' %}</a><a href="{{ routes.cart_url }}" class="bag-link" data-cart-open aria-controls="CartDrawer" aria-haspopup="dialog">Bag <span data-cart-count>({{ cart.item_count }})</span></a></div>
</header>
<dialog id="MobileNavigation" class="mobile-navigation" aria-label="Navigation">
  <div class="drawer-heading"><span class="wordmark">FORME.</span><button type="button" class="icon-button" data-dialog-close aria-label="Close navigation">{% render 'icon', name: 'close' %}</button></div>
  <nav aria-label="Mobile navigation">{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">The collection</a><a href="/pages/materials">Our materials</a><a href="/pages/journal">The journal</a>{% endif %}<a href="/products/arc-modular-sofa">Design your sofa</a><a href="/pages/delivery">Delivery & care</a></nav>
  <p class="eyebrow">{{ settings.brand_tagline | default: 'Objects for living.' | escape }}</p>
</dialog>
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Thoughtful pieces. Made for the everyday."
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu"
    }
  ]
}
{% endschema %}
