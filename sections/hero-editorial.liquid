{%- assign hero_arc = all_products['arc-modular-sofa'] -%}
{%- assign hero_arc_url = hero_arc.url | default: '/products/arc-modular-sofa' -%}
{%- for variant in hero_arc.variants -%}{%- if variant.option1 == 'Generous' and variant.option2 == 'Linen' and variant.option3 == 'Moss' -%}{%- assign hero_arc_url = hero_arc.url | append: '?variant=' | append: variant.id -%}{%- endif -%}{%- endfor -%}
<section class="editorial-hero atelier-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="hero-content">
    <p class="eyebrow"><span class="atelier-dot" aria-hidden="true"></span> {{ section.settings.eyebrow }}</p>
    <h1 id="HeroTitle-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h1>
    <p class="hero-description">{{ section.settings.description }}</p>
    <div class="hero-actions"><a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a><a class="hero-studio-link" href="/products/arc-modular-sofa">Design your Arc {% render 'icon', name: 'cube' %}</a></div>
    <div class="hero-material-note"><span class="hero-material-line" aria-hidden="true"></span><p>Natural materials.<br>Room to be yourself.</p></div>
  </div>
  <div class="hero-image">{% render 'picture', image: section.settings.image, fallback: 'atelier-hero.webp', alt: section.settings.image_alt, loading: 'eager', sizes: '(min-width: 900px) 64vw, 100vw', width: 1800, height: 1530 %}<a class="hero-object-card" href="{{ hero_arc_url }}"><span><small>IN THE ROOM</small><strong>Arc modular sofa</strong><span>Linen / Moss · Generous</span></span><span class="hero-object-arrow" aria-hidden="true">{% render 'icon', name: 'diagonal' %}</span></a><span class="hero-index">FORME / THE LIVING COLLECTION</span></div>
</section>
{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "An original FORME living room with the Arc sofa, Vale chair and Monolith table in warm afternoon light."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OBJECTS FOR LIVING"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Quiet forms.\nFull lives."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Considered furniture for unhurried moments.\nMade to become part of your everyday."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    }
  ]
}
{% endschema %}
