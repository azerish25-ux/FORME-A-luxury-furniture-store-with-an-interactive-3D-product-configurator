<dialog id="CartDrawer" class="cart-drawer" aria-labelledby="CartDrawerTitle"><div class="drawer-heading"><div><p class="eyebrow">THOUGHTFULLY CHOSEN</p><h2 id="CartDrawerTitle">Your bag<span data-drawer-count></span></h2></div><button class="icon-button" type="button" data-dialog-close aria-label="Close bag">{% render 'icon', name: 'close' %}</button></div><div class="drawer-cart-body" data-drawer-body><p>Loading your bag…</p></div><div class="drawer-cart-footer" data-drawer-footer hidden><div class="cart-total"><span>Subtotal</span><strong data-drawer-total></strong></div><p class="fine-print">Delivery and taxes calculated at checkout.</p><a href="{{ routes.cart_url }}" class="button">Review your bag {% render 'icon', name: 'arrow' %}</a><form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="underlined-link checkout-link">Continue to checkout {% render 'icon', name: 'diagonal' %}</button></form></div><p class="form-error" data-drawer-error role="alert" hidden></p></dialog>
