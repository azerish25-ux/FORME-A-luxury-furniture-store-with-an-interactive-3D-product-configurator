  <img src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" class="{{ class }}" width="{{ width | default: 1600 }}" height="{{ height | default: 1200 }}" loading="{{ loading | default: 'lazy' }}" decoding="async">
{%- endif -%}
