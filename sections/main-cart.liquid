<section class="cart-page wrap section-space" data-cart-page><div class="section-heading"><div><p class="eyebrow">THOUGHTFULLY CHOSEN</p><h1>Your bag.</h1></div><a href="{{ routes.all_products_collection_url }}" class="underlined-link">Continue exploring {% render 'icon', name: 'arrow' %}</a></div><div data-cart-page-content>
  {% if cart.item_count == 0 %}<div class="empty-state"><h2>A little space for something good.</h2><p>Find a piece that feels like you.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection {% render 'icon', name: 'arrow' %}</a></div>{% else %}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-layout"><div class="cart-items">{% for item in cart.items %}<article class="cart-item" data-cart-line="{{ item.key }}"><a href="{{ item.url }}">{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: item.product.title }}</a><div class="cart-item-info"><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2><p>{{ item.variant.title }}</p>{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% unless first_character == '_' %}<p class="fine-print">{{ property.first }}: {{ property.last }}</p>{% endunless %}{% endfor %}<p class="cart-item-price">{{ item.final_line_price | money }}</p><label for="CartQuantity-{{ forloop.index }}" class="fine-print">Quantity</label><div class="cart-line-actions"><input type="number" id="CartQuantity-{{ forloop.index }}" name="updates[]" min="0" max="99" value="{{ item.quantity }}" data-cart-quantity="{{ item.key }}"><a href="{{ item.url_to_remove }}" data-cart-remove="{{ item.key }}" class="text-button">Remove</a></div></div></article>{% endfor %}<button name="update" type="submit" class="button button--outline">Update bag</button></div><aside class="cart-summary"><p class="eyebrow">ORDER SUMMARY</p><div class="cart-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p class="fine-print">Delivery and taxes calculated at checkout.</p><label for="CartNote">A note for your delivery</label><textarea name="note" id="CartNote" rows="3" placeholder="Anything we should know?">{{ cart.note }}</textarea><button type="submit" name="checkout" class="button">Continue to checkout {% render 'icon', name: 'arrow' %}</button><p>Every piece deserves a considered arrival. <a href="/pages/delivery">Read our delivery guide.</a></p></aside></form>
  {% endif %}
</div><p class="form-error" data-cart-page-error role="alert" hidden></p></section>
{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
