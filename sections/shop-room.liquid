<section class="shop-room wrap section-space"><div class="section-heading"><div><p class="eyebrow">A ROOM, CONSIDERED</p><h2>{{ section.settings.heading }}</h2></div><span class="room-instruction">Select a piece to make it yours {% render 'icon', name: 'plus' %}</span></div><div class="room-photograph">{% render 'picture', image: section.settings.image, fallback: 'editorial-room.webp', alt: 'A considered living room featuring FORME furniture, with shoppable product markers', loading: 'lazy', width: 1800, height: 1300 %}{% for block in section.blocks %}{% assign room_product = block.settings.product %}{% if room_product != blank %}<a class="room-hotspot" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%" href="{{ room_product.url }}" {{ block.shopify_attributes }}><span class="hotspot-circle">{% render 'icon', name: 'plus' %}</span><span class="hotspot-label">{{ room_product.title }}<span>{{ room_product.price | money }} {% render 'icon', name: 'arrow' %}</span></span></a>{% endif %}{% endfor %}</div><div class="room-caption"><p>{{ section.settings.body }}</p><span class="eyebrow">LIVING ROOM / NO. 01</span></div></section>
{% schema %}
{
  "name": "Shop this room",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sunday, unhurried."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Caption",
      "default": "A softer palette. A favourite book. A room that asks nothing of you."
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Shop this room"
    }
  ]
}
{% endschema %}
