{%- assign selected_collection = section.settings.collection | default: collections.all -%}
<section class="featured-collection wrap section-space" aria-labelledby="CollectionTitle-{{ section.id }}"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 id="CollectionTitle-{{ section.id }}">{{ section.settings.heading }}</h2></div><a class="underlined-link" href="{{ selected_collection.url | default: routes.all_products_collection_url }}">View the collection {% render 'icon', name: 'arrow' %}</a></div>
  <div class="product-grid product-grid--featured">{% for product in selected_collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p>Add products to your selected collection in Shopify to introduce your pieces here.</p>{% endfor %}</div>
</section>
{% schema %}
{
  "name": "Selected pieces",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A FEW WELL-CHOSEN PIECES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The everyday, elevated."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Selected pieces"
    }
  ]
}
{% endschema %}
